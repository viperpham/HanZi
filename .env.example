# HanZi LMS — biên môi trường production
# Chép thành .env cạnh docker-compose.yml rồi điền giá trị thật.
# LƯU Ý: KHÔNG commit file .env (đã nằm trong .gitignore).

# Mật khẩu PostgreSQL (dài, ngẫu nhiên — vd sinh bằng: openssl rand -base64 24)
POSTGRES_PASSWORD=HANZI_CHANGE_ME_DB_PASSWORD

# Khoá ký JWT — bắt buộc ≥ 32 ký tự (vd sinh bằng: openssl rand -base64 48)
JWT_SECRET=HANZI_CHANGE_ME_JWT_SECRET_KEY_MIN_32_CHARACTERS_LONG!!
